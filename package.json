{
  "name": "@goldenrod-app/hyperion",
  "version": "0.2.0",
  "description": "Continuous parser for Fountain screenplay markup language.",
  "type": "module",
  "main": "dist/hyperion.js",
  "types": "dist/hyperion.d.ts",
  "exports": {
    ".": {
      "import": "./dist/hyperion.js",
      "types": "./dist/hyperion.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:esbuild": "esbuild src/hyperion.ts --bundle --format=esm --outfile=dist/hyperion.js",
    "build": "npm run clean && npm run build:types && npm run build:esbuild",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ogions/hyperion"
  },
  "author": "Zach Lo",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
