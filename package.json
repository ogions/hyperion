{
  "name": "fairfax",
  "version": "0.1.0",
  "description": "Continuous parser for Fountain screenplay markup language.",
  "type": "module",
  "main": "dist/fairfax.js",
  "types": "dist/fairfax.d.ts",
  "exports": {
      "." {
          "import": "./dist/fairfax.js",
          "types": "./dist/fairfax.d.ts"
      }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:esbuild": "esbuild src/fairfax.ts --bundle --format=esm --outfile=dist/fairfax.js",
    "build": "npm run clean && npm run build:types && npm run build:esbuild",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ogions/fairfax"
  },
  "author": "Zach Lo",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
